        <mxCell id="Dpw9qPdCpb2EvX0i0UXl-3" value="&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Отчеты&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
