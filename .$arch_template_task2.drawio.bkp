        <mxCell id="UtVjApj63TV4J5OI3_k5-24" value="&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Заказы&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
